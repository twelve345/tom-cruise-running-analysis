# Backend Environment Variables
# All variables below are RUNTIME variables (not build-time)

# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Database (REQUIRED)
# Local Development (docker-compose):
MONGO_URL=mongodb://mongo:27017/mydatabase
# Local Development (outside Docker):
# MONGO_URL=mongodb://localhost:27017/mydatabase
# Railway Production:
# MONGO_URL=mongodb://... (auto-configured by Railway when you add MongoDB service)

# TMDB API Key (REQUIRED for film metadata)
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# RAILWAY DEPLOYMENT NOTES:
# - Set NODE_ENV=production in Railway dashboard
# - MONGO_URL is auto-configured when you add the MongoDB service
# - TMDB_API_KEY must be manually added in Railway Variables tab
# - All variables are set at runtime (no rebuild required to change them)
