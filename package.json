{
  "name": "tom-cruise-running-analysis",
  "version": "1.0.0",
  "description": "Analysis of Tom Cruise running scenes using video processing and data visualization",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "husky",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "secretlint": "^13.0.7"
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.19.1 <12"
  }
}
