echo "🔍 Running pre-push checks..."
echo ""

# Lint backend
echo "→ Linting backend..."
npm run lint --workspace=backend -- --max-warnings=0 || {
  echo "❌ Backend linting failed!"
  echo "💡 Run 'npm run lint --workspace=backend' to see errors"
  exit 1
}
echo "✓ Backend linting passed"
echo ""

# Lint frontend
echo "→ Linting frontend..."
npm run lint --workspace=frontend -- --max-warnings=0 || {
  echo "❌ Frontend linting failed!"
  echo "💡 Run 'npm run lint --workspace=frontend' to see errors"
  exit 1
}
echo "✓ Frontend linting passed"
echo ""

# TypeScript type check. frontend/tsconfig.json is a solution file ("files": []),
# so `tsc -b` (build mode, incremental by default) is what checks the projects.
echo "→ Running TypeScript type check..."
(cd frontend && npx tsc -b) || {
  echo "❌ TypeScript type check failed!"
  exit 1
}
echo "✓ TypeScript type check passed"
echo ""

# The dependency audit runs in CI (.github/workflows/dependency-audit.yml) on every
# push, PR and weekly, so a newly disclosed CVE doesn't block unrelated pushes.

# Run backend tests
echo "→ Running backend tests..."
npm run test --workspace=backend || {
  echo "❌ Backend tests failed!"
  exit 1
}
echo "✓ Backend tests passed"
echo ""

# Run frontend tests
echo "→ Running frontend tests..."
npm run test --workspace=frontend -- --run || {
  echo "❌ Frontend tests failed!"
  exit 1
}
echo "✓ Frontend tests passed"
echo ""

echo "✅ All pre-push checks passed!"
